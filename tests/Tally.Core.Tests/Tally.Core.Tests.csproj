<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Lets `dotnet test` drive xunit through Microsoft.Testing.Platform (see global.json). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="..\..\src\Tally.Core\Tally.Core.csproj" />
  </ItemGroup>

</Project>
